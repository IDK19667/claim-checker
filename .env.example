# ---- AI provider (pick ONE) --------------------------------------------
# Option A: Gemini — free tier, no card needed. Get a key at
#   https://aistudio.google.com/apikey  (or via Cloud Console — see README)
# Note: Google's free tier terms say prompts may be used to improve their
# products. The paid tier does not. Decide knowingly for a classroom.
GEMINI_API_KEY=your_gemini_key_here
# Two Gemini models. The query model does the small jobs (the PubMed search,
# the guideline lookup, the stamp direction read). The verdict model writes
# the verdict and runs the faithfulness check, so it is the stronger one.
# Both have defaults in verdict.py; set them only to change them.
# GEMINI_QUERY_MODEL=gemini-3.5-flash-lite   # falls back to GEMINI_MODEL, the old name, if set
# GEMINI_VERDICT_MODEL=gemini-3.6-flash
# Set the verdict model to the query model's name to run everything on one.
# If the verdict model is rate-limited, down, gone or slower than the time
# limit, that one call runs once on the query model and a warning on the
# "evident.models" logger says so. Set to 0 to turn that off (a test run that
# must not mix models) and the error is shown instead.
# VERDICT_MODEL_FALLBACK=1
# VERDICT_MODEL_TIMEOUT_SEC=120    # one verdict-model call; 0 for no limit
# The free tier gives the full Flash models far fewer requests than Flash-Lite
# (about 20 a day against 500, per Google's quota answers; see DECISIONS.md).

# Option B: Claude — paid, ~1-3 cents per check. Get a key at
#   https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=your_anthropic_key_here
# ANTHROPIC_MODEL=claude-sonnet-5

# If both keys are set, Gemini wins. Force one with:
# LLM_PROVIDER=gemini   # or: anthropic

# ---- Rate limits (checks, not requests — each check is up to 2 AI calls)
# Defaults are sized for Gemini Flash-Lite's free tier. Set to 0 to disable.
# RATE_LIMIT_PER_USER=6              # per phone/IP address ...
# RATE_LIMIT_PER_USER_WINDOW_SEC=600 # ... per 10 minutes
# RATE_LIMIT_GLOBAL_PER_MINUTE=12
# RATE_LIMIT_GLOBAL_PER_DAY=400

# RATE_LIMIT_FEEDBACK_PER_HOUR=30   # thumbs up/down per IP

# ---- Public URL (for share links & link previews when hosted) -----------
# PUBLIC_URL=https://your-domain.example

# ---- Verdict cache -------------------------------------------------------
# Same claim within this many hours is served from SQLite (free, instant).
# VERDICT_CACHE_HOURS=24

# ---- PubMed (optional, but polite to NCBI — put your real email) ---------
NCBI_EMAIL=you@example.com
NCBI_TOOL_NAME=health-claim-checker

# ---- Pexels (footage scouting only, not used by the app) ----------------
# Free key from https://www.pexels.com/api/. Only scripts/pexels_scout.py
# reads it; the running site never calls Pexels.
# PEXELS_API_KEY=your_pexels_key_here

# ---- Flask ----------------------------------------------------------------
FLASK_SECRET_KEY=dev-secret-change-me

# The auto-reloading debugger is off by default. HOST is 0.0.0.0 so a phone
# on the same Wi-Fi can reach the dev server, and the Werkzeug debugger is a
# Python shell for anyone who can reach it. Turn it on deliberately, and only
# on a network you trust.
# FLASK_DEBUG=1
