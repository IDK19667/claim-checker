# ---- AI provider (pick ONE) --------------------------------------------
# Option A: Gemini — free tier, no card needed. Get a key at
#   https://aistudio.google.com/apikey  (or via Cloud Console — see README)
# Note: Google's free tier terms say prompts may be used to improve their
# products. The paid tier does not. Decide knowingly for a classroom.
GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-3.5-flash-lite

# Option B: Claude — paid, ~1-3 cents per check. Get a key at
#   https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=your_anthropic_key_here
# ANTHROPIC_MODEL=claude-sonnet-5

# If both keys are set, Gemini wins. Force one with:
# LLM_PROVIDER=gemini   # or: anthropic

# ---- Rate limits (checks, not requests — each check is up to 2 AI calls)
# Defaults are sized for Gemini Flash-Lite's free tier. Set to 0 to disable.
# RATE_LIMIT_PER_USER=6              # per phone/IP address ...
# RATE_LIMIT_PER_USER_WINDOW_SEC=600 # ... per 10 minutes
# RATE_LIMIT_GLOBAL_PER_MINUTE=12
# RATE_LIMIT_GLOBAL_PER_DAY=400

# RATE_LIMIT_FEEDBACK_PER_HOUR=30   # thumbs up/down per IP

# ---- Public URL (for share links & link previews when hosted) -----------
# PUBLIC_URL=https://your-domain.example

# ---- Verdict cache -------------------------------------------------------
# Same claim within this many hours is served from SQLite (free, instant).
# VERDICT_CACHE_HOURS=24

# ---- PubMed (optional, but polite to NCBI — put your real email) ---------
NCBI_EMAIL=you@example.com
NCBI_TOOL_NAME=health-claim-checker

# ---- Flask ----------------------------------------------------------------
FLASK_SECRET_KEY=dev-secret-change-me

# The auto-reloading debugger is off by default. HOST is 0.0.0.0 so a phone
# on the same Wi-Fi can reach the dev server, and the Werkzeug debugger is a
# Python shell for anyone who can reach it. Turn it on deliberately, and only
# on a network you trust.
# FLASK_DEBUG=1
